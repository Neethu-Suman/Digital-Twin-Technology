<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1100 320" width="100%" height="100%" style="background-color: #ffffff; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
  <defs>
    <marker id="arrow" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M 0 1 L 10 5 L 0 9 z" fill="#000000" />
    </marker>
  </defs>

  <!-- Connectors -->
  <!-- Top Row: 1 -> 2 -> 3 -->
  <line x1="330" y1="85" x2="390" y2="85" stroke="#000000" stroke-width="2" marker-end="url(#arrow)" />
  <line x1="690" y1="85" x2="750" y2="85" stroke="#000000" stroke-width="2" marker-end="url(#arrow)" />
  
  <!-- Turn Down: 3 -> 4 -->
  <line x1="890" y1="130" x2="890" y2="190" stroke="#000000" stroke-width="2" marker-end="url(#arrow)" />
  
  <!-- Bottom Row: 4 -> 5 -> 6 -->
  <line x1="770" y1="235" x2="710" y2="235" stroke="#000000" stroke-width="2" marker-end="url(#arrow)" />
  <line x1="410" y1="235" x2="350" y2="235" stroke="#000000" stroke-width="2" marker-end="url(#arrow)" />

  <!-- STEP 1 -->
  <rect x="50" y="40" width="280" height="90" rx="6" fill="#ffffff" stroke="#000000" stroke-width="2"/>
  <circle cx="85" cy="85" r="16" fill="#ffffff" stroke="#000000" stroke-width="2"/>
  <text x="85" y="91" fill="#000000" font-size="14" font-weight="bold" text-anchor="middle">1</text>
  <text x="120" y="91" fill="#000000" font-size="16" font-weight="600">CAD/BIM Ingestion</text>

  <!-- STEP 2 -->
  <rect x="410" y="40" width="280" height="90" rx="6" fill="#ffffff" stroke="#000000" stroke-width="2"/>
  <circle cx="445" cy="85" r="16" fill="#ffffff" stroke="#000000" stroke-width="2"/>
  <text x="445" y="91" fill="#000000" font-size="14" font-weight="bold" text-anchor="middle">2</text>
  <text x="480" y="91" fill="#000000" font-size="16" font-weight="600">Physics &amp; Kinematics</text>

  <!-- STEP 3 -->
  <rect x="770" y="40" width="280" height="90" rx="6" fill="#ffffff" stroke="#000000" stroke-width="2"/>
  <circle cx="805" cy="85" r="16" fill="#ffffff" stroke="#000000" stroke-width="2"/>
  <text x="805" y="91" fill="#000000" font-size="14" font-weight="bold" text-anchor="middle">3</text>
  <text x="840" y="91" fill="#000000" font-size="16" font-weight="600">Sensor Simulation</text>

  <!-- STEP 4 -->
  <rect x="770" y="190" width="280" height="90" rx="6" fill="#ffffff" stroke="#000000" stroke-width="2"/>
  <circle cx="805" cy="235" r="16" fill="#ffffff" stroke="#000000" stroke-width="2"/>
  <text x="805" y="241" fill="#000000" font-size="14" font-weight="bold" text-anchor="middle">4</text>
  <text x="835" y="241" fill="#000000" font-size="16" font-weight="600">Telemetry Binding</text>

  <!-- STEP 5 -->
  <rect x="410" y="190" width="280" height="90" rx="6" fill="#ffffff" stroke="#000000" stroke-width="2"/>
  <circle cx="445" cy="235" r="16" fill="#ffffff" stroke="#000000" stroke-width="2"/>
  <text x="445" y="241" fill="#000000" font-size="14" font-weight="bold" text-anchor="middle">5</text>
  <text x="475" y="241" fill="#000000" font-size="16" font-weight="600">AI &amp; ROM Integration</text>

  <!-- STEP 6 -->
  <rect x="50" y="190" width="280" height="90" rx="6" fill="#ffffff" stroke="#000000" stroke-width="2"/>
  <circle cx="85" cy="235" r="16" fill="#ffffff" stroke="#000000" stroke-width="2"/>
  <text x="85" y="241" fill="#000000" font-size="14" font-weight="bold" text-anchor="middle">6</text>
  <text x="115" y="241" fill="#000000" font-size="16" font-weight="600">WebRTC Deployment</text>
</svg>
